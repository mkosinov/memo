{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "question": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  // Manager → architect → coder → explore chain requires depth 3.
  "subagent_depth": 3
}
