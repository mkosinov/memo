# ═══════════════════════════════════════════
# Memo Backend — Configuration Template
# ═══════════════════════════════════════════
# Copy to .env for production, or use
# .env.dev / .env.test for other environments.
# ───────────────────────────────────────────
# Usage:
#   ENV_FILE=.env.dev  uv run uvicorn ...
#   ENV_FILE=.env.test pytest

# String — SQLAlchemy async database URL
# Default: sqlite+aiosqlite:///./memo.db
# Example: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./memo.db

# String — Application name (used in OpenAPI docs)
PROJECT_NAME=Memo Backend

# Comma-separated list of exact origins — CORS allowed origins.
# "*" is FORBIDDEN: the app always enables allow_credentials (cookie
# sessions), and a wildcard degrades the credentials posture (#499 §5).
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# String — Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# String — OTP code transport selector (#499 §4.2). Fail-closed: empty
# (the default) → 503 NOTIFICATION_TRANSPORT_UNAVAILABLE on POST /auth/otp/request.
# "dev" only works with ENV=development; production/test stay default-deny.
# Default: empty
OTP_TRANSPORT=

# String — callcheck (вход по звонку) transport selector (#593), the
# OTP_TRANSPORT mirror. Fail-closed: empty (the default) → NO provider →
# the "call" method is unavailable in /auth/methods and initiate answers
# 503. Values: "" / "dev" / "smsru". "dev" only works with
# ENV=development (banned in production); "smsru" demands
# SMSRU_CALLCHECK_API_KEY (fail-fast pairing check at startup).
# Default: empty
CALLCHECK_TRANSPORT=

# Secret string — sms.ru api_id (#593). SecretStr: never surfaces in
# repr/logs/errors. Required when CALLCHECK_TRANSPORT=smsru.
# Default: empty
SMSRU_CALLCHECK_API_KEY=

# Secret string — Redis connection URL for the notification queue (Redis Streams).
# Empty = transport not configured. Required when ENV=production and
# NOTIFICATION_ENABLED=true — must be rediss:// (TLS) and include credentials.
# Example: rediss://default:password@host:6379/0
REDIS_URL=
