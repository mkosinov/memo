# Web production image (GH #616, spec §3.1).
#
# Build (from repo root; the context MUST be the repo root — this is a pnpm
# workspace: web imports @memo/api-client and @memo/domain from packages/,
# and the frozen install needs the root pnpm-lock.yaml; a frontend/web-only
# context cannot see either):
#   docker build -f deploy/Dockerfile.web -t memo-web:test .
#
# Build args carry ONLY public values (spec §3.3: no secrets in image layers
# or build logs). The default /api is the prod bake — relative, same-origin
# through the edge proxy (#617).
#
# Runtime contract (spec §3.1–3.2):
#   - static export (output: 'export' in next.config.mjs) is baked here —
#     NO Node runtime at all; nginx (pinned minor) just serves the dist/ tree;
#   - SPA fallback: unknown paths resolve to /index.html (nginx-web.conf),
#     so deep links to client routes still get the shell;
#   - listens on 8080, published to host loopback only by compose (spec
#     §3.2); public exposure/SSL/domains belong to the host edge proxy
#     (#617) — no server_name assumptions in this image.

# ---- Build stage: full workspace toolchain, discarded afterwards ----------
FROM node:26-alpine AS build

# pnpm pinned to root package.json `packageManager`; bash because the root
# postinstall (install-hooks.sh) is invoked as `bash scripts/...` and alpine
# ships /bin/sh only — same fix as Dockerfile.admin (0673a962).
RUN apk add --no-cache bash && npm install -g pnpm@11.5.1

# Public build arg → ENV BEFORE `next build`: Next inlines NEXT_PUBLIC_* at
# build time.
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /repo

# Deps layer (cached unless manifests/lockfile change). All four workspace
# manifests must exist for pnpm to resolve the workspace graph; scripts/
# because the root postinstall (install-hooks.sh) runs on install (bash is
# installed for it above; the hook itself skips cleanly without a .git).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts ./scripts
COPY frontend/admin/package.json frontend/admin/
COPY frontend/web/package.json frontend/web/
COPY packages/api-client/package.json packages/api-client/
COPY packages/domain/package.json packages/domain/

# web + its workspace deps only (--filter keeps frontend/admin and its
# toolchain out of the layer).
RUN pnpm install --frozen-lockfile --filter @memo/web...

# Sources: web + the two workspace packages it imports.
COPY packages/api-client packages/api-client
COPY packages/domain packages/domain
COPY frontend/web frontend/web

# Topo-ordered by pnpm: tsup builds @memo/api-client and @memo/domain first,
# then `next build` emits the static export to frontend/web/dist (distDir
# default 'dist'; NEXT_DIST_DIR stays unset).
RUN pnpm --filter @memo/web... run build

# ---- Runtime stage: nginx serving the static export -----------------------
# Pinned minor (GH #616 review): floating `alpine` silently repins on every
# upstream release; 1.29-alpine upgrades only when this line says so.
FROM nginx:1.29-alpine AS runtime

# The export dir already includes public/ contents and _next/ hashed assets;
# nginx-web.conf replaces the default server (SPA fallback, immutable cache
# for /_next/static/).
COPY --from=build /repo/frontend/web/dist /usr/share/nginx/html
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
