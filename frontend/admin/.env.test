# E2E test environment — loaded by playwright.config.ts
# Must match backend/.env.test DATABASE_URL path so both
# the backend and tests operate on the same isolated DB.
# GH #387: 127.0.0.1 (not localhost) — same host as the playwright baseURL,
# or the SameSite=Lax session cookie never reaches the API. Standalone runs
# must ALSO export BACKEND_URL (e2e/lib/backend-url.ts errors with the
# recipe); this file only feeds the browser bundle default.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
