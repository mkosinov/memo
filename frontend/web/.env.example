# Web app environment example — copy to .env.local and fill in.
# The API origin the browser bundle talks to (dev default: same host, :8000).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── «Связаться» (#593): the administrator's messengers on the auth screen ──
# Public values (not secrets); empty default = the button is hidden.
# TELEGRAM — a username (with or without @): https://t.me/<user>?text=…
NEXT_PUBLIC_CONTACT_TELEGRAM=
# WHATSAPP — a phone number in any spacing (digits are kept):
# https://wa.me/<7XXXXXXXXXX>?text=…
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Both empty → no messenger buttons at all (the request text and
# «Скопировать текст» remain on the panel).
