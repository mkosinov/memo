# E2E test environment — loaded by playwright.config.ts (mirror of
# frontend/admin/.env.test). Standalone runs must ALSO export BACKEND_URL
# (e2e/lib/backend-url.ts errors with the recipe); this file only feeds the
# browser bundle default. The web-e2e stack (scripts/test-e2e.sh) overrides
# both vars with the run's dynamic ports — this default is for the
# standalone stack recipe only (backend :8000, admin canon).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Administrator contacts for the #593 «Связаться» panel (US-4): non-empty in
# the e2e env so the messenger links render and the specs can assert their
# hrefs (fixtures/callcheck.ts mirrors these defaults). The stack script
# exports the same pair for its own `next dev` — NEXT_PUBLIC_* is baked at
# compile time, so the values must reach the server env, not just the code.
NEXT_PUBLIC_CONTACT_TELEGRAM=MemoE2eAdmin
NEXT_PUBLIC_CONTACT_WHATSAPP=+79005550100
