#!/usr/bin/env bash
# Pre-push hook: runs local test suite, blocks push on failure
# Source: scripts/git-hooks/pre-push
# Installed by: scripts/install-hooks.sh (via postinstall)

set -euo pipefail

# Get the current worktree's root (works for both main repo and worktrees).
# When hook runs from .git/hooks/ or .git/worktrees/<name>/hooks/, git
# auto-sets GIT_DIR and GIT_WORK_TREE, so rev-parse returns the correct path.
if ! REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "❌ Not in a git repository. Pre-push hook requires a git worktree."
  exit 1
fi

TEST_SCRIPT="$REPO_ROOT/scripts/test-all.sh"

if [ ! -x "$TEST_SCRIPT" ]; then
  echo "❌ test-all.sh not found or not executable at $TEST_SCRIPT"
  echo "   Run: pnpm install (postinstall installs the hook)"
  exit 1
fi

exec "$TEST_SCRIPT"
